{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.doctorguidance.guidegram",
  "productName": "Guidegram",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
    "files": [
    "dist",
    "dist-electron",
    "resources"
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "resources/icon512.png",
    "category": "public.app-category.social-networking",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "linux": {
    "icon": "resources/icon512.png",
    "category": "Network;Chat",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "tar.gz",
        "arch": [
          "x64"
        ]
      }
    ]
  }
}
