{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.doctorguidance.guidegram",
  "productName": "Guidegram",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
    "files": [
    "dist",
    "dist-electron",
    "resources"
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  }
}
